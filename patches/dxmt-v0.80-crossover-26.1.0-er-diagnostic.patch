+               ctx.resource.output.ptr_float4, const_index
+             ) >>= [=, &ctx](auto fvec4) {
+        auto marked = ctx.air.getNonFiniteToMarker(fvec4, mask);
+        auto ivec4 = ctx.builder.CreateBitCast(marked, ctx.types._int4);
+        return to_desired_type_from_int_vec4(ivec4, desired_type, mask) |
+               [=, &ctx](auto value) {
+                 return ctx.builder.CreateInsertValue(ret, value, {to_element});
+               };
+      };
+    });
+  };
+}
