 namespace dxmt {
 
+static bool
+er_diagnostics_enabled() {
+  auto value = env::getEnvVar("DXMT_ER_DIAGNOSTICS");
+  return !value.empty() && value != "0";
+}
+
+static void
+dump_er_pixel_shader(const Sha1Digest &sha1, const void *bytecode, size_t bytecode_length) {
+  if (!er_diagnostics_enabled())
+    return;
+
+  auto path = env::getEnvVar("DXMT_ER_DIAGNOSTICS_PATH");
+  if (path.empty())
+    path = env::getEnvVar("DXMT_LOG_PATH");
+  if (path.empty() || path == "none")
+    path = ".";
+  if (path.back() != '/')
+    path += '/';
+
+  path += env::getExeBaseName() + "_ps_" + sha1.string() + ".dxbc";
+  std::ofstream output(str::topath(path.c_str()).c_str(),
+                       std::ios::out | std::ios::binary | std::ios::trunc);
+  if (!output) {
+    Logger::warn(str::format("ERDIAG failed to dump pixel shader: ", path));
+    return;
+  }
+  output.write(reinterpret_cast<const char *>(bytecode), bytecode_length);
+  output.close();
+  Logger::info(str::format("ERDIAG pixel shader sha1=", sha1.string(),
+                           " bytes=", bytecode_length, " path=", path));
+}
