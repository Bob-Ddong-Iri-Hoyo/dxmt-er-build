+  Value *
+  getNonFiniteToMarker(Value *Operand, uint32_t ComponentMask) {
+    auto OperandType = Operand->getType();
+    llvm::Value *BitsAbs = getInt(0x7fffffffu);
+    llvm::Value *BitsInf = getInt(0x7f800000u);
+    llvm::Type *TyCast = getIntTy();
+    llvm::Value *Marker = getFloat(1.0f);
+
+    if (auto TyVec = dyn_cast<llvm::FixedVectorType>(OperandType)) {
+      auto NumElements = TyVec->getNumElements();
+      BitsAbs = builder.CreateVectorSplat(NumElements, BitsAbs);
+      BitsInf = builder.CreateVectorSplat(NumElements, BitsInf);
+      TyCast = getIntTy(NumElements);
+      Marker = builder.CreateVectorSplat(NumElements, Marker);
+
+      auto NonFinite = builder.CreateICmpUGE(
+        builder.CreateAnd(builder.CreateBitCast(Operand, TyCast), BitsAbs),
+        BitsInf
+      );
+      llvm::Value *AnyNonFinite = nullptr;
+      for (uint32_t i = 0; i < NumElements; i++) {
+        if (!(ComponentMask & (1u << i)))
+          continue;
+        auto Lane = builder.CreateExtractElement(NonFinite, i);
+        AnyNonFinite = AnyNonFinite ? builder.CreateOr(AnyNonFinite, Lane) : Lane;
+      }
+      if (!AnyNonFinite)
+        return Operand;
+      auto MarkAllLanes = builder.CreateVectorSplat(NumElements, AnyNonFinite);
+      return builder.CreateSelect(MarkAllLanes, Marker, Operand);
+    }
+
+    auto NonFinite = builder.CreateICmpUGE(
+      builder.CreateAnd(builder.CreateBitCast(Operand, TyCast), BitsAbs),
+      BitsInf
+    );
+    return builder.CreateSelect(NonFinite, Marker, Operand);
+  };
