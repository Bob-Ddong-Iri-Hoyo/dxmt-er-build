+  Value *
+  getNonFiniteToZero(Value *Operand) {
+    auto OperandType = Operand->getType();
+    llvm::Value *BitsAbs = getInt(0x7fffffffu);
+    llvm::Value *BitsInf = getInt(0x7f800000u);
+    llvm::Type *TyCast = getIntTy();
+    if (auto TyVec = dyn_cast<llvm::FixedVectorType>(OperandType)) {
+      BitsAbs = builder.CreateVectorSplat(TyVec->getNumElements(), BitsAbs);
+      BitsInf = builder.CreateVectorSplat(TyVec->getNumElements(), BitsInf);
+      TyCast = getIntTy(TyVec->getNumElements());
+    }
+    auto NonFinite = builder.CreateICmpUGE(builder.CreateAnd(builder.CreateBitCast(Operand, TyCast), BitsAbs), BitsInf);
+    return builder.CreateSelect(NonFinite, Constant::getNullValue(OperandType), Operand);
+  };
